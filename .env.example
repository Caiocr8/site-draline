# Copie este arquivo para .env.local (no seu computador) e cadastre as
# mesmas variáveis na hospedagem (Vercel: Settings > Environment Variables).
# Passo a passo completo no README, seção "Configurar o envio de e-mail".

# Chave da API do Resend — resend.com/api-keys (permissão "Sending access")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Quem RECEBE as mensagens do formulário (vários separados por vírgula).
# Sem domínio verificado, tem que ser o MESMO e-mail da conta Resend.
CONTACT_TO_EMAIL=alinemariaralmeida.adv@gmail.com

# Remetente. Deixe em branco até verificar um domínio no Resend
# (o site usa onboarding@resend.dev). Depois, use um endereço do domínio:
# CONTACT_FROM_EMAIL="Dra. Aline Maria <contato@alinemariaalmeida.adv.br>"
CONTACT_FROM_EMAIL=

# "sim" envia ao cliente um e-mail confirmando o recebimento.
# Só funciona com CONTACT_FROM_EMAIL de domínio verificado.
CONTACT_CONFIRMACAO=nao
