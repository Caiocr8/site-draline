# Copie este arquivo para .env.local (no seu computador) ou cadastre as
# mesmas variáveis no painel da Vercel (Settings > Environment Variables).

# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# E-mail que vai RECEBER as mensagens do formulário (pode separar vários por vírgula)
CONTACT_TO_EMAIL=email-da-dra@exemplo.com

# Remetente. Enquanto não verificar um domínio no Resend, deixe em branco:
# o site usa onboarding@resend.dev, que só entrega no e-mail da conta Resend.
# Depois de verificar o domínio: "Site Dra. Aline Maria <contato@seudominio.com.br>"
CONTACT_FROM_EMAIL=
